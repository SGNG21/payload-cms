# Copier ce fichier en .env puis renseigner les valeurs réelles.
# Ne jamais commiter .env — voir .gitignore.

# Postgres dédié à cette instance (schéma applicatif isolé : voir schemaName
# 'payload' dans payload.config.ts). Format :
# postgresql://user:password@host:port/database
DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:5432/polyvaillant_cms

# Secret de signature des sessions/tokens Payload. Générer une valeur aléatoire
# forte, par ex. : openssl rand -base64 32
PAYLOAD_SECRET=

# Token Vercel Blob (Storage > Blob dans le dashboard Vercel), scope
# lecture/écriture. Format attendu : vercel_blob_rw_<store_id>_<random>
BLOB_READ_WRITE_TOKEN=

# URL publique de cette instance (utilisée par Payload pour les liens absolus,
# CORS, etc.). En local : http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
